# Proposed wiring for the Adafruit ESP32-S3 TFT Feather and Adafruit OV5640
# parallel breakout. Opt in only after wiring to match. MCU GPIOs, not labels.
# Camera D2..D9 are driver D0..D7. Keep breakout XCLK selection at EXT.
CONFIG_DEER_PIN_D0=18
CONFIG_DEER_PIN_D1=17
CONFIG_DEER_PIN_D2=16
CONFIG_DEER_PIN_D3=15
CONFIG_DEER_PIN_D4=14
CONFIG_DEER_PIN_D5=8
CONFIG_DEER_PIN_D6=5
CONFIG_DEER_PIN_D7=6
CONFIG_DEER_PIN_PCLK=9
CONFIG_DEER_PIN_VSYNC=10
CONFIG_DEER_PIN_HREF=11
CONFIG_DEER_PIN_XCLK=12
CONFIG_DEER_PIN_SDA=42
CONFIG_DEER_PIN_SCL=41
CONFIG_DEER_PIN_PWDN=-1
CONFIG_DEER_PIN_RESET=-1
# CONFIG_DEER_PINS_CONFIRMED is not set
